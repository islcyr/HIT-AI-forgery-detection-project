# Normalize text in Git; preserve executable script compatibility on Linux.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.wav binary
*.flac binary
*.pt binary
*.pth binary
*.ckpt binary
*.safetensors binary
