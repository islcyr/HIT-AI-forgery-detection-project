{
  "models": [
    {
      "cwd": "../..",
      "command": [
        "bash",
        "methods/cfprf/scripts/cfprf.sh",
        "{audio}",
        "--variant",
        "HAD",
        "--device",
        "cuda:0",
        "--output",
        "{output}"
      ],
      "required_files": [
        "methods/cfprf/scripts/cfprf.sh",
        "methods/cfprf/infer_cfprf.py",
        ".envs/cfprf/bin/python"
      ],
      "timeout_sec": 540,
      "output_converter": "model_integration.cfprf_output:convert_output",
      "converter_options": {
        "checkpoint_variant": "HAD"
      },
      "descriptor": {
        "id": "cfprf-had",
