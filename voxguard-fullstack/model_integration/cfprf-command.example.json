        "is_mock": false,
        "decision_operator": "gt",
        "capabilities": {
          "detection": true,
          "localization": true
        },
        "input": {
          "sample_rate_hz": 16000,
          "min_duration_sec": 0.5,
          "max_duration_sec": 21.25
        },
        "localization_resolution_sec": 0.02,
        "thresholds": {
          "detection": 0.5,
          "localization": 0.5,
          "version": "cfprf-verification-gt-0.5-v1"
        }
      }
    }
  ]
