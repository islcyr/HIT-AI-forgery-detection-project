# The project root run.py reads the root .env file. These values are examples.
ENABLE_MOCK=true
VOXGUARD_DATA_DIR=./data
VOXGUARD_ADAPTER_FACTORY=
# 配置式 PyTorch 适配器需要此变量；启用真实模型时先修改工厂入口并禁用模拟模型。
VOXGUARD_MODEL_CONFIG=models/custom/config.json
QUEUE_CAPACITY=4
TASK_TIMEOUT_SEC=600
MODEL_LOAD_TIMEOUT_SEC=120
RETENTION_SEC=86400
# Only needed when the frontend is hosted separately; comma-separated exact origins.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 命令行模型配置；使用时设置工厂为 model_integration.command_adapter:create_adapter
# VOXGUARD_COMMAND_CONFIG=model_integration/cfprf-command.json
